; Engine configuration file.
; Правит только агент CORE (или по инструкции в ARCH.md).

config_version=5

[application]

config/name="Острова"
config/description="Выживание на архипелаге: защити флаг, строй мосты, переживи акул."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://scripts/core/settings.gd"
Events="*res://scripts/core/events.gd"
Items="*res://scripts/core/items.gd"
Game="*res://scripts/core/game.gd"
SandTracks="*res://scripts/world/sand_tracks.gd"
DevConsole="*res://scripts/core/dev_console.gd"
Surfaces="*res://scripts/mech/surfaces.gd"
ShowBus="*res://scripts/mech/show_bus.gd"
Perception="*res://scripts/mech/perception.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=19.6

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.55, 0.72, 0.85, 1)
textures/vram_compression/import_etc2_astc=true

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg", "res://addons/sky_3d/plugin.cfg", "res://addons/multimesh_scatter/plugin.cfg")

[shader_globals]

wind_dir={
"type": "vec2",
"value": Vector2(1, 0)
}
wind_speed={
"type": "float",
"value": 3.0
}
wind_gust={
"type": "float",
"value": 0.0
}
weather_rain={
"type": "float",
"value": 0.0
}
weather_storm={
"type": "float",
"value": 0.0
}
weather_wetness={
"type": "float",
"value": 0.0
}
sea_time={
"type": "float",
"value": 0.0
}
sea_level={
"type": "float",
"value": 0.0
}
sand_tracks_map={
"type": "sampler2D",
"value": ""
}
sand_tracks_rect={
"type": "vec4",
"value": Vector4(0, 0, 96, 0)
}

[importer_defaults]

scene={
"meshes/create_shadow_meshes": true,
"meshes/generate_lods": true,
"meshes/light_baking": 1
}
texture={
"mipmaps/generate": true,
"process/size_limit": 4096
}
